# Frontend Environment Variables
# Local development — use localhost
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
# Production deployment — set these in Vercel dashboard:
# VITE_API_URL=https://dukaflow-api.onrender.com/api
# VITE_SOCKET_URL=https://dukaflow-api.onrender.com

# Clerk Authentication — publishable key only (secret key goes on the Render backend!)
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_UP_URL=/sign-up
VITE_CLERK_AFTER_SIGN_IN_URL=/auth-resolve
VITE_CLERK_AFTER_SIGN_UP_URL=/auth-resolve
